<?xml version="1.0" encoding="utf-8"?>
<!-- a dialog grows from a little smaller with a bounce, like the expressive components -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
  <scale
      android:fromXScale="0.82" android:toXScale="1.0"
      android:fromYScale="0.82" android:toYScale="1.0"
      android:pivotX="50%" android:pivotY="55%"
      android:duration="360"
      android:interpolator="@android:interpolator/overshoot" />
  <translate
      android:fromYDelta="6%" android:toYDelta="0"
      android:duration="360"
      android:interpolator="@android:interpolator/decelerate_cubic" />
  <alpha
      android:fromAlpha="0" android:toAlpha="1"
      android:duration="140"
      android:interpolator="@android:interpolator/linear" />
</set>
