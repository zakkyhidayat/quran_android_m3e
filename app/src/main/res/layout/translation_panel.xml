<?xml version="1.0" encoding="utf-8"?>
<!-- the translation inside the floating ayah window: it takes the height it needs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

  <com.quran.labs.androidquran.view.QuranSpinner
      android:id="@+id/translator"
      android:layout_width="wrap_content"
      android:layout_height="36dp"
      android:layout_marginTop="8dp"
      android:layout_marginLeft="12dp"
      android:layout_marginStart="12dp"
      android:minWidth="160dp"
      android:background="@drawable/bg_translator_pill"
      android:paddingLeft="0dp"
      android:paddingRight="36dp"
      android:paddingStart="0dp"
      android:paddingEnd="36dp"
      />

  <com.quran.labs.androidquran.view.InlineTranslationView
      android:id="@+id/translation_view"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      />

  <LinearLayout
      android:id="@+id/empty_state"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="12dp"
      android:orientation="vertical"
      android:visibility="gone"
      >
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="@string/need_translation"
        />
    <Button
        android:id="@+id/get_translations_button"
        style="?attr/materialButtonTonalStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/get_translations"
        />
  </LinearLayout>

  <ProgressBar
      android:id="@+id/progress"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:layout_margin="16dp"
      />
</LinearLayout>
