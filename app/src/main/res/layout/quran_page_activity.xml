<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:keepScreenOn="true"
    >

  <!-- the top bar is Compose and stays above the page; it never hides -->
  <androidx.compose.ui.platform.ComposeView
      android:id="@+id/reader_toolbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content" />

  <FrameLayout
      android:id="@+id/reader_page_area"
      android:clipChildren="false"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">

    <androidx.viewpager.widget.NonRestoringViewPager
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/quran_pager"
        />

    <!-- Page, Arabic and translation, Translation only: floats at the bottom centre -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/reader_modes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="0dp" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/reader_marker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp" />

    <com.quran.page.common.toolbar.AyahToolBar
        android:id="@+id/ayah_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        />

    <com.quran.mobile.feature.audiobar.AudioBarWrapper
        android:id="@+id/audio_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        />
  </FrameLayout>
</LinearLayout>
